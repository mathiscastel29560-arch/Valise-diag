# À coller à la fin du ~/.bashrc de l'utilisateur qui s'autoconnecte sur tty1
# (voir systemd/getty-autologin-tty1.conf). Lance le menu automatiquement à
# la connexion sur la console physique, sauf si l'onglet Paramètres a
# désactivé le démarrage automatique (fichier ~/.autostart_disabled créé par
# system_tools.appliquer_autostart) ou si on est en session SSH.

if [ -z "$SSH_CONNECTION" ] && [ "$(tty)" = "/dev/tty1" ] && [ ! -f "$HOME/.autostart_disabled" ]; then
    cd /home/pi/valise-diag || exit
    source .venv/bin/activate
    python3 -m valise_diag --config config/app.yaml
fi
